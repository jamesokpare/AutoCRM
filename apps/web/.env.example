# Copy this file to `apps/web/.env` and fill in real values.
# All variables below are REQUIRED — the app validates them at startup
# (see packages/env/src/server.ts) and will fail to boot if any are missing,
# which surfaces in the UI as "Sign up failed (status 500)".

# PostgreSQL / Neon connection string used by the app at runtime.
# Use the POOLED Neon host (the one containing "-pooler") here — the serverless
# WebSocket driver the app runs on is built for the pooled endpoint.
# IMPORTANT: the schema must be applied to THIS database before signup/login
# will work. Apply it with `pnpm run db:migrate:deploy` (production) or
# `pnpm run db:push` (quick local prototyping) from the repo root.
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?sslmode=require"

# Direct (UNPOOLED) Neon connection string — host WITHOUT "-pooler".
# Used only by schema operations (migrate / db push): Neon's pgbouncer pooler
# can't hold the long-running session those commands need. If unset, schema
# commands fall back to DATABASE_URL, which can hang or fail against the pooler.
# See packages/db/prisma.config.ts.
DATABASE_URL_DIRECT="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign auth tokens. MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-string-at-least-32-chars"

# Base URL of the deployed web app (used for auth callbacks).
BETTER_AUTH_URL="http://localhost:3001"

# Allowed origin for auth requests (usually the same as BETTER_AUTH_URL).
CORS_ORIGIN="http://localhost:3001"
