# Copy this file to `apps/web/.env` and fill in real values.
# All variables below are REQUIRED — the app validates them at startup
# (see packages/env/src/server.ts) and will fail to boot if any are missing,
# which surfaces in the UI as "Sign up failed (status 500)".

# PostgreSQL / Neon connection string.
# IMPORTANT: the schema must be applied to THIS database before signup/login
# will work. After setting this, run `pnpm run db:push` from the repo root.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign auth tokens. MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-string-at-least-32-chars"

# Base URL of the deployed web app (used for auth callbacks).
BETTER_AUTH_URL="http://localhost:3001"

# Allowed origin for auth requests (usually the same as BETTER_AUTH_URL).
CORS_ORIGIN="http://localhost:3001"
