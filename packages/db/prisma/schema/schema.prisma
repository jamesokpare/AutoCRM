generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums (SPEC §3)
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  SERVICE_ADVISOR
  TECHNICIAN
  PARTS_STAFF
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  ON_HOLD
  CUSTOMER_CANCELLED
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  ARCHIVED
}

// A manually-set, client-level service status surfaced in the dashboard
// filters. Mirrors the five OrderStatus values plus the two derived dashboard
// buckets (DUE_TODAY, PARTS_NOT_AVAILABLE) so a client can be filtered even
// before it has any order (e.g. a freshly imported client). CLT.
enum ServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  ON_HOLD
  DUE_TODAY
  PARTS_NOT_AVAILABLE
  CUSTOMER_CANCELLED
}

enum PartAvailability {
  AVAILABLE
  NOT_AVAILABLE
  ON_ORDER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Channel {
  SMS
  WHATSAPP
  EMAIL
}

enum CommunicationType {
  STATUS_UPDATE
  APOLOGY
  MONTHLY_CHECKIN
  MANUAL
}

// SENT only reachable in the messaging phase.
enum CommunicationState {
  DRAFT
  SENT
}

enum ReminderType {
  DAILY_UPDATE
  MONTHLY_CHECKIN
  CUSTOM
}

enum ReminderState {
  PENDING
  DONE
  DISMISSED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_OVERDUE
  LOW_RATING
  REMINDER_DUE
  GENERIC
}

// Outbound email provider for the messaging settings (admin/messaging).
// RESEND uses the Resend HTTPS REST API; SMTP is reserved for future use.
enum EmailProvider {
  RESEND
  SMTP
}

// Per-recipient delivery state for a BulkMessage row.
enum BulkRecipientState {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ─────────────────────────────────────────────────────────────
// Domain models (SPEC §3)
// ─────────────────────────────────────────────────────────────

model Client {
  id               String       @id @default(cuid())
  name             String
  phone            String?
  email            String?
  whatsapp         String?
  address          String?
  preferredChannel Channel?
  status           ClientStatus   @default(ACTIVE)
  // Manually-set service status (CLT). Null = unset; the dashboard filters fall
  // back to the client's order statuses when this is null.
  serviceStatus    ServiceStatus?
  // Free-text override that takes precedence over `serviceStatus` for display.
  // Lets a user type a status that doesn't fit the fixed enum (e.g. "Awaiting
  // customer approval"). Null = unset.
  serviceStatusCustom String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  vehicles       Vehicle[]
  orders         Order[]
  feedback       Feedback[]
  communications Communication[]
  reminders      Reminder[]
  updates        ClientUpdate[]
  bulkMessages   BulkMessageRecipient[]

  @@index([name])
  @@index([serviceStatus])
}

// Free-form daily progress note logged against a client. Open to all
// authenticated users (add + edit) — there is no role gate on this feature.
model ClientUpdate {
  id        String   @id @default(cuid())
  clientId  String
  authorId  String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User   @relation("ClientUpdateAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([authorId])
  @@index([createdAt])
}

// Clock-in / clock-out attendance record. One open row (clockOut = null) per
// user at a time. Visible to the whole team.
model Attendance {
  id        String    @id @default(cuid())
  userId    String
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clockIn])
}

model Vehicle {
  id        String   @id @default(cuid())
  clientId  String
  make      String
  model     String
  year      Int
  plate     String?
  vin       String?
  color     String?
  mileage   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([clientId])
}

model Order {
  id            String      @id @default(cuid())
  clientId      String
  vehicleId     String
  description   String
  receivedDate  DateTime    @default(now())
  expectedDate  DateTime?
  status        OrderStatus @default(PENDING)
  // Required (enforced in action) when status is FAILED or ON_HOLD — CLT-07.
  statusReason  String?
  assignedTechId String?
  // Free-text technician name — used when the technician isn't an app user.
  // When both fields are set, the free-text name wins in display fallbacks.
  assignedTechName String?
  // Free-text item or part the client requested at intake.
  itemRequested String?
  // External / customer-supplied order reference (distinct from the cuid `id`).
  externalOrderId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignedTech  User?           @relation("OrderAssignedTech", fields: [assignedTechId], references: [id], onDelete: SetNull)
  parts         Part[]
  feedback      Feedback[]
  communications Communication[]
  reminders     Reminder[]

  @@index([clientId])
  @@index([vehicleId])
  @@index([assignedTechId])
  @@index([status])
}

model Part {
  id           String           @id @default(cuid())
  orderId      String
  name         String
  availability PartAvailability @default(NOT_AVAILABLE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Feedback {
  id          String   @id @default(cuid())
  clientId    String
  orderId     String?
  rating      Int // 1–5
  comments    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order     Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User   @relation("FeedbackCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([orderId])
  @@index([createdById])
}

model Communication {
  id        String             @id @default(cuid())
  clientId  String
  orderId   String?
  channel   Channel
  type      CommunicationType
  state     CommunicationState @default(DRAFT)
  content   String
  senderId  String
  sentAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sender User   @relation("CommunicationSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([orderId])
  @@index([senderId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  date        DateTime // the work day
  dueDate     DateTime?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignee  User @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdBy User @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([assigneeId])
  @@index([createdById])
  @@index([status])
  @@index([date])
}

model PerformanceReview {
  id                String   @id @default(cuid())
  reviewerId        String
  revieweeId        String
  cycle             String // e.g. "2026-W21"
  deliverablesScore Int
  communicationScore Int
  comments          String?
  // Configurable extra criteria stored as JSON for now (PERF-02).
  extraScores       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reviewer User @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, revieweeId, cycle])
  @@index([revieweeId])
  @@index([cycle])
}

model CompanyKPI {
  id           String   @id @default(cuid())
  name         String
  // Free-form category label so KPIs can be grouped by area (e.g. "Customer
  // Service", "Engineering", "Operations"). Optional — null = uncategorised.
  category     String?
  targetValue  Float
  currentValue Float?
  unit         String?
  periodStart  DateTime
  periodEnd    DateTime
  autoComputed Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  votes        KpiVote[]

  @@index([periodStart, periodEnd])
  @@index([category])
}

/// Per-user rating of how a KPI was performed (1..5 stars). Open to every
/// authenticated team member; one vote per (kpi, user) — re-voting updates the
/// existing row.
model KpiVote {
  id        String   @id @default(cuid())
  kpiId     String
  userId    String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kpi  CompanyKPI @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  user User       @relation("KpiVoteCaster", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kpiId, userId])
  @@index([kpiId])
  @@index([userId])
}

model Reminder {
  id         String        @id @default(cuid())
  type       ReminderType
  orderId    String?
  clientId   String?
  dueAt      DateTime
  recurrence String?
  state      ReminderState @default(PENDING)
  assigneeId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  order    Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignee User?   @relation("ReminderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([clientId])
  @@index([assigneeId])
  @@index([dueAt])
  @@index([state])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

/// Singleton row holding the workshop's outbound messaging credentials. The
/// `singleton` literal in `key` keeps it unique without relying on application
/// code. Credentials are stored as-is — restrict the admin/messaging page to
/// ADMIN/MANAGER via the `manage_messaging` capability.
model MessagingSettings {
  id  String @id @default(cuid())
  key String @unique @default("singleton")

  // WhatsApp Cloud API (Meta Graph API)
  whatsappEnabled         Boolean @default(false)
  whatsappPhoneNumberId   String?
  whatsappAccessToken     String?
  whatsappBusinessNumber  String?
  whatsappDisplayName     String?

  // Email
  emailEnabled     Boolean        @default(false)
  emailProvider    EmailProvider?
  emailFromName    String?
  emailFromAddress String?
  emailApiKey      String?
  emailSmtpHost    String?
  emailSmtpPort    Int?
  emailSmtpUser    String?
  emailSmtpPassword String?
  emailSmtpSecure  Boolean?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("MessagingSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// A single bulk-send campaign. One row per channel+content+sender; per-client
/// dispatch state lives on `BulkMessageRecipient`.
model BulkMessage {
  id          String   @id @default(cuid())
  channel     Channel
  subject     String?
  content     String
  senderId    String
  totalCount  Int      @default(0)
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  createdAt   DateTime @default(now())

  sender     User                   @relation("BulkMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipients BulkMessageRecipient[]

  @@index([senderId])
  @@index([createdAt])
}

model BulkMessageRecipient {
  id            String             @id @default(cuid())
  bulkMessageId String
  clientId      String
  destination   String
  state         BulkRecipientState @default(PENDING)
  error         String?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())

  bulkMessage BulkMessage @relation(fields: [bulkMessageId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([bulkMessageId])
  @@index([clientId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  userId     String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([userId])
}
